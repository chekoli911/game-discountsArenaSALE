"1":697,"7":739,"14":827,"21":944,"28":1078,"56":1940},"prices_p3":{"1":899,"7":1092,"14":1292,"21":1728,"28":1933,"56":3479},"price_min":697,"lang_label":"","genre":"","categories":[],"publisher":"Epic Games Inc.","voice":"Английский","text_translation":"Русский, Английский","rating":4.63,"release_date":"","is_preorder":false,"is_new":false,"image_url":"","screenshots":["https://image.api.playstation.com/vulcan/ap/rnd/202310/2703/2a33358df3bb88ad0ad64b909ebbadd83606357e95d5ad2c.jpg","https://image.api.playstation.com/vulcan/ap/rnd/202310/2703/5b1101cf2452895fbd304a9547e8abe2f8d211dd6aeb7257.jpg","https://image.api.playstation.com/vulcan/ap/rnd/202310/2703/3afa8e091cbad5c6386a4e0d758561b27737b5e4c2563ee6.jpg","https://image.api.playstation.com/vulcan/ap/rnd/202310/2703/0c4dd6f90512a7b1c9a644ed6cafe47a7eba1a866b01f5c5.jpg","https://image.api.playstation.com/vulcan/ap/rnd/202310/2703/7a869be5403a0333f746c9776fcaafe212f37b466890c935.jpg"],"store_url":"https://store.playstation.com/en-tr/concept/10002065","description":"Городок Брайт Фоллс вдруг становится местом ритуальных убийств - и тут приходит Сага Андерсон, агент ФБР, которая уже давно считает свои дела нераскрываемыми.  \n\nНо дело не остаётся на бумаге. У неё на глазах начинает оживать старый роман-триллера - и он сам становится частью реальности.  \n\nАлан Уэйк - писатель, заточённый в кошмаре, пишет мрачный текст, чтобы изменить мир и сбежать от своей тьмы. А Андерсон - борется с ужасами наяву, как будто сама реальность начинает дышать через его руки.  \n\nИграйте за двух героев: один в преступлении, другой - в пытках реальности. Оба ведут борьбу с тьмой, но не знают, как они связаны. И всё равно - свет остаётся их последней надеждой.","seo_title":"Alane Wake 2 PS5 аренда игры","seo_descr":"Аренда Alane Wake 2 PS5 на PlayStation.","external_id":"","catalog_added_at":"2026-08-18T19:08:21Z"},{"id":"alan-wake-2-deluxe-edition-ps5","slug":"alan-wake-2-deluxe-edition-ps5","sku":"rent-alan-wake-2-deluxe-edition-ps5"